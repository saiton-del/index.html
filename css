/* ==========================
   CSS VARIABLES
========================== */

:root{

    --brand:#2563eb;
    --accent:#10b981;
    --background:#f4f6f9;
    --surface:#ffffff;
    --text:#1f2937;
    --secondary:#6b7280;

}

/* ==========================
   RESET
========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:Arial, Helvetica, sans-serif;
    background:var(--background);
    color:var(--text);

}

/* ==========================
   GRID LAYOUT
========================== */

.dashboard{

    display:grid;

    grid-template-columns:250px 1fr;

    min-height:100vh;

}

/* ==========================
   SIDEBAR
========================== */

.sidebar{

    background:var(--brand);

    color:white;

    padding:25px;

    display:flex;

    flex-direction:column;

}

.logo{

    margin-bottom:40px;

}

.sidebar ul{

    list-style:none;

    display:flex;

    flex-direction:column;

    gap:18px;

}

.sidebar a{

    text-decoration:none;

    color:white;

    display:block;

    padding:10px;

    border-radius:8px;

    transition:.2s;

}

.sidebar a:hover{

    background:rgba(255,255,255,.2);

}

/* ==========================
   MAIN CONTENT
========================== */

.main-content{

    display:flex;

    flex-direction:column;

}

/* ==========================
   HEADER
========================== */

.header{

    background:var(--surface);

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:25px;

    box-shadow:0 2px 8px rgba(0,0,0,.08);

}

.header p{

    color:var(--secondary);

}

.profile{

    background:var(--accent);

    color:white;

    padding:12px 18px;

    border-radius:25px;

}

/* ==========================
   CARDS
========================== */

.cards{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

    gap:20px;

    padding:25px;

}

.card{

    background:var(--surface);

    padding:25px;

    display:flex;

    flex-direction:column;

    justify-content:space-between;

    border-radius:12px;

    min-height:150px;

    box-shadow:0 2px 8px rgba(0,0,0,.08);

    transition:
        transform .25s,
        box-shadow .25s;

}

.card h3{

    margin-bottom:20px;

}

.card p{

    font-size:28px;

    font-weight:bold;

    color:var(--brand);

}

/* ==========================
   MICRO INTERACTIONS
========================== */

.card:hover,
.card:focus{

    transform:translateY(-6px);

    box-shadow:0 12px 20px rgba(0,0,0,.18);

    outline:none;

}

/* ==========================
   RESPONSIVE
========================== */

@media(max-width:768px){

.dashboard{

    grid-template-columns:1fr;

}

.sidebar{

    flex-direction:row;

    justify-content:space-between;

    align-items:center;

}

.sidebar ul{

    flex-direction:row;

    flex-wrap:wrap;

}

.header{

    flex-direction:column;

    gap:15px;

    text-align:center;

}

}

/* ==========================
   DARK MODE
========================== */

@media(prefers-color-scheme:dark){

:root{

    --brand:#3b82f6;
    --accent:#22c55e;
    --background:#111827;
    --surface:#1f2937;
    --text:#f9fafb;
    --secondary:#d1d5db;

}

}
